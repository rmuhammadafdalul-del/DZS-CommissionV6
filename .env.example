# Discord
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
GUILD_ID=PASTE_SERVER_ID_HERE

# Struktur server
# Category ORDER: semua ticket/order commission dibuat di bawah category ini.
ORDER_CATEGORY_ID=PASTE_ORDER_CATEGORY_ID_HERE
# Channel TESTIMONI: semua feedback customer diposting di sini.
TESTIMONI_CHANNEL_ID=PASTE_TESTIMONI_CHANNEL_ID_HERE

# Optional: channel log aktivitas bot/order
LOG_CHANNEL_ID=PASTE_LOG_CHANNEL_ID_HERE
STAFF_ROLE_ID=PASTE_STAFF_ROLE_ID_HERE

# Backward compatibility (opsional; tidak perlu diisi jika pakai variable baru)
# TICKET_CATEGORY_ID=PASTE_ORDER_CATEGORY_ID_HERE
# FEEDBACK_CHANNEL_ID=PASTE_TESTIMONI_CHANNEL_ID_HERE

# Persistent database directory
# Railway/Render: /app/data
# Pterodactyl: ./data (default)
DATA_DIR=./data
